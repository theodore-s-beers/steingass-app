{
	"name": "steingass-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "wrangler types --check && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"format": "oxfmt",
		"knip": "knip",
		"lint": "oxfmt --check && oxlint",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"types": "wrangler types"
	},
	"dependencies": {
		"marked": "^18.2.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"knip": "^6.45.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"wrangler": "^4.160.0"
	}
}
